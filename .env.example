# Contraseña única para entrar a /admin (sin sistema de usuarios).
ADMIN_PASSWORD=cambiame

# Supabase (Project Settings > API). La service role key se usa solo del
# lado del servidor (server components / server actions), nunca se expone
# al cliente.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
