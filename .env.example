# Contraseña única para entrar a /admin (queda como corrección manual, no
# como el flujo normal de actualización — ver README).
ADMIN_PASSWORD=cambiame

# Supabase (Project Settings > API). La service role key se usa solo del
# lado del servidor (server components / server actions), nunca se expone
# al cliente.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (Google AI Studio). Podés reusar la misma API key de otro
# proyecto; el free tier no tiene límite de "un key por proyecto".
GEMINI_API_KEY=your-gemini-api-key
# Opcional: fijar un modelo puntual si querés usar el mismo que en otro
# proyecto. Por defecto usa el alias "más nuevo estable" de Flash.
GEMINI_MODEL=gemini-flash-latest

# Secreto que protege /api/cron/check-strike de ser disparado por
# cualquiera. Generá un valor random (ej: openssl rand -hex 32) y cargalo
# también como env var en Vercel — Vercel lo manda automáticamente como
# header Authorization en cada corrida del cron.
CRON_SECRET=generá-un-valor-random-largo
